# ==============================================================================
# PipLeague Vercel Environment Configuration
# ==============================================================================

# Public URL of your deployed application
NEXT_PUBLIC_APP_URL="https://pipleague.vercel.app"

# Optional: Custom Deriv App ID (Deriv public feed works with default without any key)
NEXT_PUBLIC_DERIV_APP_ID="1085"

# Optional: WebRTC Live Voice Chat via LiveKit (cloud.livekit.io)
# If provided, enables live mic room voice mesh between dueling traders
NEXT_PUBLIC_LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# Optional: Host Admin Passphrase
ADMIN_SECRET_KEY="pipleague-director-secret-change-me"
